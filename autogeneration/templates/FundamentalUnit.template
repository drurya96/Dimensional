#ifndef STATIC_DIMENSION_{{ dim.name.upper() }}_H
#define STATIC_DIMENSION_{{ dim.name.upper() }}_H

#include <string_view>

#include "Dimension_Impl/FundamentalDimensions/{{ dim.name }}_dimension_Impl.h"

#include "Dimension_Core/internal_temp/units/new_unit_stuff.h"

namespace dimension
{
   {% for name, unit in dim.units.items() %}
   // Only really need empty struct - WIP
   struct {{ name }} : public {{ dim.name }}Unit<{{ name }}> {
      static constexpr std::string_view name_view = "{{ unit.name }}";
      static constexpr std::string_view abbr_view = "{{ unit.abbreviation }}";
      static constexpr std::string_view dimName_view = "{{ dim.name }}";
   };

   // Should only need this part - WIP
   template<> struct unit_traits<{{ name }}>{
      using dimension = {{ dim.name }}Type; // Consider renaming to {{ dim.name }}_dimension
      static constexpr std::string_view name = "{{ unit.name }}";
      static constexpr std::string_view abbr = "{{ unit.abbreviation }}";
      static constexpr std::string_view dimName = "{{ dim.name }}";
      static constexpr int id = 0;
   };

   {% endfor %}

   {% for name, unit in dim.units.items() %}
   {% if name != dim.base_unit %}
   {% set conversion = dim.base.conversions.To[name] %}
   {% if conversion.__class__.__name__ == 'list' %}
   template<> struct Conversion<{{ dim.base_unit }}, {{ name }}> { static constexpr double slope = ({{ conversion[0] }}{%if 'e' not in conversion[0]|string %}.0{%endif%} / {{ conversion[1] }}{%if 'e' not in conversion[1]|string %}.0{%endif%}); };
   {% else %}
   template<> struct Conversion<{{ dim.base_unit }}, {{ name }}> { static constexpr double slope = {{ conversion }}; };
   {% endif %}
   {% endif %}
   {% endfor %}

   {% for name, unit in dim.units.items() %}
   {% if unit.si_prefixes %}
   ALL_SI_PREFIXES({{ name }}, "{{ unit.abbreviation }}", {{ dim.name }}Unit);
   {% endif %}
   {% endfor %}

}



{% if dim.has_extras %}
#include "extensions/{{ dim.name }}Extras.h"
{% endif %}

#endif //STATIC_DIMENSION_{{ dim.name.upper() }}_H
