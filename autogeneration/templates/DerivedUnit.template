#ifndef STATIC_DIMENSION_{{ dim.Dimension|upper }}_H
#define STATIC_DIMENSION_{{ dim.Dimension|upper }}_H

#include "Dimension_Impl/DerivedDimensions/{{ dim.Dimension }}_dimension_Impl.h"

#include "Dimension_Core/internal_temp/units/new_unit_stuff.h"
#include "Dimension_Core/internal_temp/units/factor.h"
#include "Dimension_Core/internal_temp/symbol/symbols.h"

namespace dimension
{
  {#-------------------------------------------#
   # Helper fundamental-like units (if any)    #
   #-------------------------------------------#}
  {% if dim.HelperUnits and dim.HelperUnits|length > 0 %}
  // Helper fundamental units used only to compose derived units
  {% for h in dim.HelperUnits %}
  struct {{ h.key }}{};

  template<> struct unit_traits<{{ h.key }}>
  {
     using dimension = {{ h.Dim }}Type;
     static constexpr std::string_view name   = "{{ h.Name }}";
     static constexpr std::string_view abbr   = "{{ h.Abbreviation }}";
     static constexpr std::string_view dimName= "{{ dim.Dimension }}";
     static constexpr int id = 0;
  };

{% for c in h.Conversions %}
template<> struct Conversion<{{ h.key }}, {{ c.To }}>
{
  using scale = factor_t<
    std::ratio<{{ c.rnum }}, {{ c.rden }}>,
    std::tuple<
      {%- for r in c.ratioExponents -%}
        {{- ", " if not loop.first else "" -}}
        ratio_exponent<std::ratio<{{ r.baseNum }}, {{ r.baseDen }}>, {{ r.expNum }}, {{ r.expDen }}>
      {%- endfor -%}
    >
    {%- if c.symbols|length > 0 -%}
    , std::tuple<
      {%- for s in c.symbols -%}
        {{- ", " if not loop.first else "" -}}
        symbol_exponent<{{ s.name }}, {{ s.num }}, {{ s.den }}>
      {%- endfor -%}
    >
    {%- endif -%}
  >;
};
{% endfor %}

  {% endfor %}
  {% endif %}

  {#-------------------------------------------#
   # Derived units (as products of base units) #
   #-------------------------------------------#}
  {% for u in dim.Units %}
  struct {{ u.key }}
  {
     using units = std::tuple<
        {%- for e in u.Exponents -%}
        unit_exponent<{{ e.Unit }}, {{ e.Num }}, {{ e.Den }}>{% if not loop.last %}, {% endif %}
        {%- endfor -%}
     >;
  };

  template<> struct unit_traits<{{ u.key }}>
  {
     // If/when you add names/abbr to JSON for derived units, emit here.
     using units = std::tuple<
        {%- for e in u.Exponents -%}
        unit_exponent<{{ e.Unit }}, {{ e.Num }}, {{ e.Den }}>{% if not loop.last %}, {% endif %}
        {%- endfor -%}
     >;
  };
  {% endfor %}
}

{% if dim.HasExtras %}
#include "extensions/{{ dim.Dimension }}Extras.h"
{% endif %}

#endif // STATIC_DIMENSION_{{ dim.Dimension|upper }}_H
